{
  "name": "atelier-evac",
  "version": "2.0.15",
  "private": true,
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "immer": "^11.2.9",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "productName": "Atelier Plans Evacuation",
  "description": "Logiciel de création de plans d'évacuation (hors ligne)",
  "main": "electron/main.cjs",
  "author": "Atelier Evac",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit -p . && vite build",
    "start": "electron .",
    "app": "npm run build && electron .",
    "test": "vitest run",
    "selftest": "npm run build && electron . --selftest",
    "dist": "npm run build && electron-builder --win nsis",
    "release": "npm run dist && node scripts/publish.mjs",
    "fetch-pictos": "node scripts/fetch-iso7010.mjs",
    "release:github": "npm run dist && node scripts/publish.mjs --github"
  },
  "build": {
    "appId": "be.atelierevac.app",
    "productName": "Atelier Plans Evacuation",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "planevac",
        "name": "Projet de plan d'évacuation",
        "description": "Projet Atelier Plans d'Évacuation",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Atelier-Plans-Evacuation-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atelier Plans Evacuation",
      "language": "1036",
      "installerLanguages": [
        "fr_FR"
      ],
      "uninstallDisplayName": "Atelier Plans Evacuation",
      "deleteAppDataOnUninstall": false
    }
  }
}
